# Silicon Labs CP2102 USB-to-UART Bridge for LD06 DToF LiDAR
# Automatically grant access to USB control node for baudrate setup & bind usbserial driver
SUBSYSTEM=="usb", ATTR{idVendor}=="10c4", ATTR{idProduct}=="ea60", MODE="0666", GROUP="dialout", RUN+="/sbin/modprobe usbserial vendor=0x10c4 product=0xea60"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0666", GROUP="dialout"
